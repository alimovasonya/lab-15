#include <stdio.h>
#include <string.h>
int main(void) {
    char text[32], out[32];
    if (fgets(text, sizeof(text), stdin) == NULL)
        return 1;
    text[strcspn(text, "\n")] = '\0';
    if (strlen(text) > 30)
        return 1;
    size_t j = 0;
    for (size_t i = 0; text[i] != '\0'; i++) {
        if (text[i] >= '0' && text[i] <= '9') {
            out[j++] = text[i];
        }
    }
    out[j] = '\0';
    printf("[%s]\n", out);
    return 0;
}
